server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Handle Single Page Application routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy normalizer requests to bim-normalizer
    location /normalizer/ {
        proxy_pass ${NORMALIZER_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        # IFC ingestion and export can take several minutes
        proxy_connect_timeout 600s;
        proxy_send_timeout    600s;
        proxy_read_timeout    600s;

        # Allow large IFC file uploads (schedule import, etc.)
        client_max_body_size 512m;
        proxy_buffering off;
    }

    # Proxy BCF-API requests to bcf-server
    location /bcf/ {
        proxy_pass ${BCF_SERVER_URL}bcf/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        client_max_body_size 512m;
        proxy_buffering off;
    }

    location /bcf-bridge/ {
        proxy_pass ${BCF_SERVER_URL}bcf-bridge/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # bcf-server's own standalone admin page (bcf/admin.py) — no trailing
    # slash so this also matches the bare /admin path itself, not just
    # /admin/* sub-routes (login, api, etc.).
    location /admin {
        proxy_pass ${BCF_SERVER_URL}admin;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
