server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Handle Single Page Application routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html doesn't carry a content hash, so without an explicit
    # Cache-Control a browser's heuristic freshness (RFC 7234 4.2.2, keyed
    # off Last-Modified) can treat a stale copy as "fresh enough" and skip
    # revalidation entirely after a rebuild — this bit us: the dashboard only
    # loaded correctly in incognito (empty cache) until this was added.
    # no-cache still allows caching, it just forces an If-None-Match/ETag
    # revalidation on every load, so a rebuilt page is always picked up.
    # Hashed asset filenames (Vite's default assetsDir) never change content
    # under the same name, so those get the opposite: cached forever.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Proxy normalizer requests to bim-normalizer
    location /normalizer/ {
        proxy_pass ${NORMALIZER_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        # IFC ingestion and export can take several minutes
        proxy_connect_timeout 600s;
        proxy_send_timeout    600s;
        proxy_read_timeout    600s;

        # Allow large IFC file uploads (schedule import, etc.)
        client_max_body_size 512m;
        proxy_buffering off;
    }

    # Proxy BCF-API requests to bcf-server
    location /bcf/ {
        proxy_pass ${BCF_SERVER_URL}bcf/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        client_max_body_size 512m;
        proxy_buffering off;
    }

    location /bcf-bridge/ {
        proxy_pass ${BCF_SERVER_URL}bcf-bridge/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # bcf-server's own standalone admin page (bcf/admin.py) — no trailing
    # slash so this also matches the bare /admin path itself, not just
    # /admin/* sub-routes (login, api, etc.).
    location /admin {
        proxy_pass ${BCF_SERVER_URL}admin;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
