# Separate, slim image for the bcf-server entrypoint — it never touches
# ifcopenshell/ifc5d/ifctester/ifcclash/specklepy/numpy/fastembed/ezdxf/
# cairosvg/python-docx/openpyxl/reportlab/httpx/mcp[cli], all of which
# bim-normalizer's main Dockerfile installs for main.py/converge_mcp.py's
# sake (see requirements-bcf-server.txt for how that was verified). Sharing
# that image just for bcf_server.py meant an ~800MB image — mostly
# ifcopenshell + numpy + the ONNX runtime fastembed pulls in — for a process
# that only ever does BCF topic/comment/viewpoint CRUD, its own admin panel,
# and OAuth. Same build context (./bim-normalizer) as the main Dockerfile
# though, via docker-compose.yml's `dockerfile: Dockerfile.bcf-server`
# override, so it stays a single source tree with two Dockerfiles rather
# than a separate repo/context to keep in sync.
FROM python:3.11-slim

WORKDIR /app

# curl only — the HEALTHCHECK below shells out to it. No poppler-utils/
# LibreDWG build stage here: those exist solely for bim-normalizer's own
# document-preview thumbnails (routers/documents.py), which bcf-server
# never touches (it has no document-thumbnail routes of its own).
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-bcf-server.txt requirements.txt
# pip/setuptools/wheel are build-only tooling, same reasoning as the main
# Dockerfile — uninstalled once the actual dependencies are in place.
RUN pip install --no-cache-dir -r requirements.txt \
    && pip uninstall -y pip setuptools wheel

# Still the whole source tree (simpler than maintaining a second COPY
# allowlist that'd silently go stale the next time bcf/ picks up a new
# shared db/ module) — the size win here is almost entirely from the
# slimmer requirements.txt above, not from excluding a few hundred KB of
# unused .py files.
COPY . .

RUN useradd -m -u 1000 app && chown -R app:app /app
USER app

EXPOSE 8004

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8004/health || exit 1

CMD ["python", "bcf_server.py"]
