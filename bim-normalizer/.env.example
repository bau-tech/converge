SPECKLE_SERVER_URL=https://speckle.example.com
SPECKLE_TOKEN=your_token_here

# Publicly reachable base URL for this app's bim-normalizer (through your reverse
# proxy, e.g. https://dashboard.example.com/normalizer). Required for the
# webhook auto-sync feature — leave blank to disable it.
PUBLIC_BASE_URL=
# Background re-scan interval (seconds) — a dormant-project safety net for
# missed webhook deliveries. A project someone actually opens is scanned
# immediately via the frontend's on-load POST /auto-sync/scan instead.
AUTO_SYNC_SCAN_INTERVAL_S=3600

PG_HOST=192.168.1.10
PG_PORT=5432
PG_USER=speckle
PG_PASS=speckle
PG_NAME=speckle

PORT=8002
LOG_LEVEL=info

# AI chat providers (set whichever you use; others can stay blank)
OPENAI_API_KEY=
MISTRAL_API_KEY=

# MCP remote auth (streamable HTTP / SSE) — generate with: openssl rand -hex 32
# Empty string disables auth (safe for local stdio; required for remote access)
MCP_API_KEY=

# bcf-server (shares this same .env) — shared Bearer credential checked on
# every BCF request and gating the /admin panel. Required for bcf-server.
BCF_API_KEY=
# Signs the OAuth2/OIDC id_token for clients like BIMcollab ZOOM. Falls back
# to BCF_API_KEY, then a dev-only default, if left unset.
BCF_OIDC_SECRET=
# Optional startup seed for one bcf_users account — convenience only, the
# /admin panel is always reachable via BCF_API_KEY regardless.
BCF_ADMIN_EMAIL=
BCF_ADMIN_PASSWORD=
