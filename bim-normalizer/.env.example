SPECKLE_SERVER_URL=https://speckle.example.com
SPECKLE_TOKEN=your_token_here

# Publicly reachable base URL for this app's bim-normalizer (through your reverse
# proxy, e.g. https://dashboard.example.com/normalizer). Required for the
# webhook auto-sync feature — leave blank to disable it.
PUBLIC_BASE_URL=
# How often (seconds) to re-scan watched servers for newly-created projects
# that don't have a webhook yet. Existing projects sync instantly regardless.
AUTO_SYNC_SCAN_INTERVAL_S=900

PG_HOST=192.168.1.10
PG_PORT=5432
PG_USER=speckle
PG_PASS=speckle
PG_NAME=speckle

PORT=8002
LOG_LEVEL=info

# AI chat providers (set whichever you use; others can stay blank)
OPENAI_API_KEY=
MISTRAL_API_KEY=

# MCP remote auth (streamable HTTP / SSE) — generate with: openssl rand -hex 32
# Empty string disables auth (safe for local stdio; required for remote access)
MCP_API_KEY=
