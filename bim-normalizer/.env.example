# Used only by the local Claude Code MCP integration — the root .mcp.json
# runs converge_mcp.py directly on this machine over stdio (not through
# docker-compose), and python-dotenv loads this file for SPECKLE_TOKEN since
# .mcp.json's own `env` block doesn't set it (SPECKLE_SERVER_URL/
# NORMALIZER_URL are already set there and take precedence over this file).
#
# Everything the containerized stack needs (Postgres, Nextcloud, BCF,
# dashboard auth, the streamable-HTTP MCP service, etc.) lives in the root
# .env/.env.example instead — docker-compose reads that file and passes
# values into each container explicitly. This file is never read by
# docker-compose and never reaches the built image (see .dockerignore).
SPECKLE_SERVER_URL=https://your-speckle-server.com
SPECKLE_TOKEN=your_token_here

# Optional — only needed to use the BCF/Documents MCP tools locally.
# BCF_SERVER_URL defaults to http://localhost:8004, which already works here
# since docker-compose publishes bcf-server's port to the host.
BCF_API_KEY=your_bcf_api_key_here
MCP_DASHBOARD_EMAIL=
MCP_DASHBOARD_PASSWORD=
