// This file is served as a plain static asset to every visitor, logged in
// or not — never add a real secret to it. BCF_API_KEY and the LLM provider
// keys (OLLAMA/MISTRAL/ANTHROPIC/GROQ/GEMINI_API_KEY) used to be injected
// here so the frontend could show/use an operator's server-wide default,
// but that meant handing those credentials to literally anyone who loaded
// the page — BCF_API_KEY in particular fully bypasses the per-project role
// model (see bcf/auth.py). Both now stay server-side only: BCF auth uses
// the browser's own dashboard_session cookie instead (bcf/auth.py's
// _dashboard_identity), and routers/chat.py reads its provider keys
// straight from its own environment when a request doesn't supply one.
window.__CONFIG__ = {
  NORMALIZER_URL: "${VITE_NORMALIZER_URL}",
  SPECKLE_SERVER: "${VITE_SPECKLE_SERVER}",
  SPECKLE_TOKEN: "${VITE_SPECKLE_TOKEN}",
  SHARE_LINK_MODE: "${VITE_SHARE_LINK_MODE}",
  DEMO_LOGIN_EMAIL: "${VITE_DEMO_LOGIN_EMAIL}",
  DEMO_LOGIN_PASSWORD: "${VITE_DEMO_LOGIN_PASSWORD}",
  EXTRA_SPECKLE_SERVERS: "${VITE_EXTRA_SPECKLE_SERVERS}",
  BCF_URL: "${VITE_BCF_URL}",
  OLLAMA_BASE_URL: "${VITE_OLLAMA_BASE_URL}",
  OLLAMA_MODEL: "${VITE_OLLAMA_MODEL}",
  LMSTUDIO_BASE_URL: "${VITE_LMSTUDIO_BASE_URL}",
  LMSTUDIO_MODEL: "${VITE_LMSTUDIO_MODEL}",
  COLLABORA_ENABLED: "${VITE_COLLABORA_ENABLED}"
}
