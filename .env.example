# Speckle Server Connection
VITE_SPECKLE_SERVER=https://your-speckle-server.com
VITE_SPECKLE_TOKEN=your_speckle_token_here
VITE_ETL_URL=/api
VITE_NORMALIZER_URL=http://localhost:8002

# OpenAI API Key for AI Assistant
VITE_OPENAI_API_KEY=sk-...

# Ollama (Local AI)
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=qwen2.5:1.5b

# LM Studio (Local AI)
VITE_LMSTUDIO_BASE_URL=http://localhost:1234/v1
VITE_LMSTUDIO_MODEL=qwen/qwen3-4b

# Mistral AI
VITE_MISTRAL_API_KEY=your_mistral_key_here

# Docker: ETL backend URL (used by nginx proxy)
BACKEND_URL=http://localhost:8001/
