# IANA timezone applied to every container (logs, Nextcloud's activity feed
# and notification-email timestamps, cron.php's schedule). Purely cosmetic —
# every stored timestamp is UTC-based (Postgres TIMESTAMPTZ, Python
# datetime.now(timezone.utc)) regardless of this value, so changing it can't
# corrupt or reinterpret existing data, only how it's displayed/logged.
TZ=Europe/Berlin

# PostgreSQL (shared by bim-normalizer, bcf-server, and Nextcloud's own DB —
# see postgres-init/01-nextcloud-db.sh). PG_HOST only matters for tools
# connecting from outside the compose network (e.g. a local DB client) —
# bim-normalizer/bcf-server always talk to postgres:5432 directly. PG_PORT
# is the HOST port the container publishes on (mapped to the container's
# fixed internal 5432 regardless of this value).
PG_HOST=localhost
PG_PORT=5433
PG_USER=speckle
PG_PASS=speckle
PG_NAME=speckle

# Speckle Server Connection
VITE_SPECKLE_SERVER=https://your-speckle-server.com
VITE_SPECKLE_TOKEN=your_speckle_token_here
VITE_NORMALIZER_URL=http://localhost:8002

# Optional additional Speckle servers the dashboard's server-switcher can use
# (Speckle personal access tokens are server-specific, so each one needs its
# own token here) — comma-separated "Display Name|https://server.url|token"
# triples. Client-visible (VITE_ = same as the token above) — injected into
# the frontend at container start (src/runtimeConfig.js), not baked into the
# image, so changing this doesn't need a rebuild. Also passed to bcf-server so
# its admin panel's Document Roles project picker can resolve project names on
# these servers too, not just the default one. Leave blank if you only use one
# Speckle server.
VITE_EXTRA_SPECKLE_SERVERS=

# Controls what an anonymous (not logged in) visitor gets when they open a
# /shareXXX link, now that the dashboard sits behind a login gate (see
# DASHBOARD_SESSION_SECRET below) — without this, share links 404'd into the
# sign-in screen since the whole app used to require a session first.
#   full     — anonymous visitors get the same fully-interactive dashboard a
#               logged-in visitor would (drag/resize/add panels, switch
#               project/model, AI chat) preloaded with the shared layout.
#               BCF and Documents stay blocked either way — those routers
#               require a login server-side regardless of this setting.
#   readonly — anonymous visitors get a locked-down view: the 3D viewer and
#               chart panels as shared, but no layout editing, no
#               project/model switching, no chat/BCF/documents/share-admin.
VITE_SHARE_LINK_MODE=full

# Publicly reachable base URL for this dashboard's nginx, ending in /normalizer
# (nginx proxies /normalizer/ through to bim-normalizer). Required for the
# webhook auto-sync feature (Server dropdown > Auto-sync toggle) — leave blank
# to disable it. Read by docker-compose and passed into the bim-normalizer
# and bcf-server containers as PUBLIC_BASE_URL.
PUBLIC_BASE_URL=https://your-dashboard-domain.com/normalizer
# Publicly reachable base URL for the frontend itself (site root, no path) —
# used to build the clickable "View issue" link in BCF assignment emails.
# Optional: if unset, derived by stripping a trailing "/normalizer" off
# PUBLIC_BASE_URL above, which is correct for this repo's own nginx.conf.template
# layout. Only set this explicitly if your reverse proxy serves the frontend
# and /normalizer on different hosts/paths than that.
# PUBLIC_APP_URL=https://your-dashboard-domain.com
# Background re-scan interval (seconds) — a dormant-project safety net for
# missed webhook deliveries. A project someone actually opens is scanned
# immediately via the frontend's on-load POST /auto-sync/scan instead.
AUTO_SYNC_SCAN_INTERVAL_S=3600
# Background document reconciliation interval (seconds) — same kind of
# safety net as above, but for files that reached Nextcloud some other way
# than the dashboard's own upload/move/revise/delete calls.
DOCUMENT_SYNC_SCAN_INTERVAL_S=3600

# debug / info / warning / error — passed to both bim-normalizer and bcf-server
LOG_LEVEL=debug

# MCP server remote auth (streamable HTTP) — generate with: openssl rand -hex 32
# Empty string disables auth (safe for local stdio; required for remote access)
MCP_API_KEY=
# Host headers the MCP server will accept (DNS-rebinding allow-list), comma-separated
# e.g. mcp.example.com,192.168.1.10:8003
MCP_ALLOWED_HOSTS=
# Login for the MCP server's Documents/CDE tools (a real bcf_users account —
# grant it project roles via bcf-server's /admin panel for anything past
# reads). Leave blank to fall back to BCF_ADMIN_EMAIL/BCF_ADMIN_PASSWORD below.
MCP_DASHBOARD_EMAIL=
MCP_DASHBOARD_PASSWORD=

# OpenAI API Key for AI Assistant
VITE_OPENAI_API_KEY=sk-...

# Ollama (Local AI)
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=qwen2.5:1.5b

# LM Studio (Local AI)
VITE_LMSTUDIO_BASE_URL=http://localhost:1234/v1
VITE_LMSTUDIO_MODEL=qwen/qwen3-4b

# Mistral AI
VITE_MISTRAL_API_KEY=your_mistral_key_here

# Anthropic (Claude)
VITE_ANTHROPIC_API_KEY=your_anthropic_key_here

# BCF server — shared Bearer credential used both by bcf-server (backend check)
# and the dashboard's own BCF panel (sent on every request). Required — an
# empty value means the dashboard's Authorization header is just "Bearer ",
# which bcf-server will reject as an invalid token. Generate with: openssl rand -hex 32
BCF_API_KEY=
# Signs the id_token issued by the OAuth2/OIDC login flow (bcf/oauth.py) for
# clients like BIMcollab ZOOM that require a real-looking Authorization
# Code + PKCE flow. Falls back to BCF_API_KEY, then a hardcoded dev value,
# if left blank.
BCF_OIDC_SECRET=
# Idempotent startup seed for one bcf_users account, granted is_admin=TRUE
# on every startup regardless of whether the row already existed. This is
# NOT just a convenience default: /admin is gated on is_admin (added after
# discovering any bcf_users account could otherwise reach it), and no
# account has is_admin=TRUE until one is granted it — either this seed, or
# an existing admin promoting another user from the panel's Users tab. BCF_API_KEY
# does NOT grant /admin access. Leaving both of these unset on a fresh
# deployment means nobody can log into /admin at all.
BCF_ADMIN_EMAIL=
BCF_ADMIN_PASSWORD=

# Signs the main dashboard's own login session cookie (bim-normalizer's
# dashboard_auth/session.py) — real accounts against bcf_users (same table
# used above). Falls back to BCF_OIDC_SECRET, then BCF_API_KEY, if left
# blank (same fallback-chain convention as the BCF admin panel's own
# session/OAuth signing) — set explicitly in production. Generate with:
# openssl rand -hex 32
DASHBOARD_SESSION_SECRET=

# DEV/TESTING ONLY. Skips the dashboard login screen and all ISO 19650
# author/reviewer/approver role checks entirely for the bim-normalizer
# container. Leave unset/false always — only ever set to true in your own
# local .env, NEVER in a deployed environment. Logs a warning on startup
# whenever enabled.
# DASHBOARD_AUTH_BYPASS=true

# Nextcloud (bundled docker-compose service — document storage/versioning
# backend for the Documents panel). Never exposed to end users directly.
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASS=
# Generate via Nextcloud's Settings > Security > "Create new app password"
# once the container is up. Set here — docker-compose passes it through to
# bim-normalizer as-is.
NEXTCLOUD_APP_PASSWORD=
# Admin/debug port only — never proxied by this dashboard's nginx.
NEXTCLOUD_PORT=8005
# Only override these two if bim-normalizer should talk to a Nextcloud
# instance other than the bundled container, or use a dedicated WebDAV
# service account instead of the admin one above (NEXTCLOUD_USER falls back
# to NEXTCLOUD_ADMIN_USER/NEXTCLOUD_APP_PASSWORD if unset).
# NEXTCLOUD_URL=http://nextcloud
# NEXTCLOUD_USER=admin

# Optional — in-browser Office editing (Collabora Online, via Nextcloud's
# richdocuments/WOPI integration) for .docx/.xlsx/.pptx/.odt/.ods/.odp
# documents in the Documents panel. Off by default; the standard read-only
# preview (docx-preview/SheetJS) always works regardless of this setting.
# Two things both need to be true to actually enable it:
#   1. Deploy with the optional compose file added:
#        docker compose -f docker-compose.yml -f docker-compose.collabora.yml up -d
#   2. COLLABORA_ENABLED=true below.
# On a brand-new install this is all that's needed (see
# nextcloud-hooks/post-installation/install-richdocuments.sh). On an
# ALREADY-RUNNING Nextcloud instance, post-installation hooks never re-run —
# see that same script's header comment for the one-time `occ` commands to
# run by hand instead.
# COLLABORA_ENABLED=true
# Admin/debug port only, same convention as NEXTCLOUD_PORT above.
# COLLABORA_PORT=9980
# Regex-escaped hostname the browser will actually load the editor from
# (Collabora enforces this against the Referer/Origin it sees) — not the
# internal "nextcloud" service name. No default; required if the above is set.
# COLLABORA_ALLOWED_DOMAIN=converge\.chladny\.de
# Full https:// URL of the same domain above — this is what actually gets
# handed to the browser as the editor iframe's origin. Leave unset and
# .docx/.xlsx previews still work (server-to-server calls use an internal
# URL regardless), but in-browser editing won't load without this set to a
# real, publicly-reachable origin (a reverse-proxy host in front of
# COLLABORA_PORT, with a valid cert — self-signed/HTTP won't satisfy
# Collabora's own CSP frame-ancestors check).
# COLLABORA_PUBLIC_URL=https://collabora.example.com
# Same hostname as COLLABORA_PUBLIC_URL, but bare (no scheme, matching
# coolwsd.xml's server_name — see docker-compose.collabora.yml). Required
# alongside COLLABORA_PUBLIC_URL: without it, Collabora self-reports
# whatever internal Docker hostname Nextcloud used to reach it in its own
# discovery XML, and the editing iframe silently fails to load even though
# COLLABORA_PUBLIC_URL is set correctly on the Nextcloud side.
# COLLABORA_SERVER_NAME=collabora.example.com

# Optional — email side of the notification feed (document-workflow events
# and BCF issue "assigned to" — notifications/, db/notifications.py). Leave
# SMTP_HOST unset to run in-app-notifications-only; nothing else in this file
# needs to change. PUBLIC_APP_URL (above) builds the BCF email's "View issue"
# deep link when set (or derivable from PUBLIC_BASE_URL).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=converge@your-domain.com
# SMTP_USE_TLS=true
